{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/claude-code-guardrails/hooks/session-clock.sh", "timeout": 10 },
          { "type": "command", "command": "bash ~/claude-code-guardrails/hooks/notes-pull.sh", "timeout": 30, "async": true }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/claude-code-guardrails/hooks/block-pipe-to-shell.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/claude-code-guardrails/hooks/zero-byte-guard.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/claude-code-guardrails/hooks/notes-writeback-gate.sh", "timeout": 15 },
          { "type": "command", "command": "bash ~/claude-code-guardrails/hooks/session-clock.sh --record", "timeout": 10 }
        ]
      }
    ]
  }
}
